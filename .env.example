OpenAI Admin API key, used only by `burnfuse poll` for the organization costs API.
Read-only. Never uploaded.
OPENAI_ADMIN_KEY=

# Used for the OpenRouter live-usage poll. A standard key is enough.
OPENROUTER_API_KEY=

# Optional: POST here when a breaker trips (Slack, Discord, or any webhook).
BURNFUSE_WEBHOOK=

# Optional: override the shared state file location.
# BURNFUSE_STATE=~/.burnfuse/state.json