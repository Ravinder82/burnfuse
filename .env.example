# Optional provider keys for live spend reads. You can also paste these keys
# into the app itself, under Settings → Your keys — and a key pasted there is
# the one the app uses, even if a variable below is set in your shell.
# Read-only. Never uploaded.

# OpenAI organization costs API. Requires an Admin key.
OPENAI_ADMIN_KEY=

# OpenRouter live credit usage. A standard key is enough.
OPENROUTER_API_KEY=

# Optional: POST here when a breaker trips (Slack, Discord, or any webhook).
BURNFUSE_WEBHOOK=

# Optional: override the state file location (default ~/.burnfuse/state.json).
# BURNFUSE_STATE=~/.burnfuse/state.json

# Optional: override where provider keys are stored (default ~/.burnfuse/keys.json).
# BURNFUSE_KEYS=~/.burnfuse/keys.json